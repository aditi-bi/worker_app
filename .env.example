# Use the in-browser mock API (MSW). Set to "false" to call the real FastAPI backend.
VITE_USE_MOCKS=true
# Base URL of the FastAPI backend (no trailing slash). "/api/v1" works with the dev proxy below.
VITE_API_BASE_URL=/api/v1
# Dev only: forward /api to this FastAPI origin when VITE_USE_MOCKS=false
# VITE_API_PROXY_TARGET=http://localhost:8000

# Number of the existing inbound call setup (Ask Phala button opens the phone dialler with it). Leave empty until it is known.
VITE_PHALA_INBOUND_NUMBER=

# Google Apps Script web app that receives applications and adds them to a Google Sheet (see design/apps-script/README.md).
# Leave empty to use the normal /applications API instead.
VITE_APPLY_SCRIPT_URL=

# Voice by Sarvam for the ten questions. Address of the server that holds the Sarvam key and answers /transcribe and /speak.
# "/voice" uses the built-in dev server (put SARVAM_API_KEY=... in .env.local, never here). Empty = the phone's own voice.
VITE_VOICE_API_URL=
# With the real backend: VITE_VOICE_API_URL=https://<backend address>/voice (uses VITE_PROFILE_API_TOKEN below). In dev with the profile proxy: /profile-api/voice.

# Interim: the bearer token the backend's /worker-profile routes require (put it in .env.local, not here).
# Anything in a VITE_ variable is visible in the built app, so replace this with a per-profile token or a one-time code before launch.
VITE_PROFILE_API_TOKEN=

# Connect ONLY the profile (register, update, read, call) to the real backend while jobs, hisaab and rates stay on the mock.
# Dev, no CORS needed, token stays out of the browser (put these two in .env.local):
#   PROFILE_API_PROXY_TARGET=https://<backend address>
#   PROFILE_API_TOKEN=<token>
#   VITE_PROFILE_API_URL=/profile-api
# Live site: VITE_PROFILE_API_URL=https://<backend address> (needs CORS on the backend).
VITE_PROFILE_API_URL=

# Real jobs: the job list server's address, without a path. Jobs and the rates screen are then worked out from GET /api/jobs/.
# Dev: put JOBS_API_PROXY_TARGET=https://<job server> in .env.local and VITE_JOBS_API_URL=/jobs-api.
# Live: server/start.ts needs JOBS_API_TARGET (and JOBS_API_TOKEN if the job server asks for one); the app uses VITE_JOBS_API_URL=/jobs-api.
VITE_JOBS_API_URL=
