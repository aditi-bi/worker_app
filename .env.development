# Use the in-browser mock API (MSW). Set to "false" to call the real FastAPI backend.
VITE_USE_MOCKS=true
# Base URL of the FastAPI backend (no trailing slash). "/api/v1" works with the dev proxy below.
VITE_API_BASE_URL=/api/v1
# Dev only: forward /api to this FastAPI origin when VITE_USE_MOCKS=false
# VITE_API_PROXY_TARGET=http://localhost:8000

# The number workers call to talk to Phala (inbound calls).
VITE_PHALA_INBOUND_NUMBER=+918065356505

# Google Apps Script web app URL for applications (see design/apps-script/README.md). Empty = mock/real /applications API.
# VITE_APPLY_SCRIPT_URL= (set in .env.local instead)

# Voice by Sarvam: "/voice" uses the dev server (key in .env.local as SARVAM_API_KEY). Empty = the phone's own voice.
# VITE_VOICE_API_URL= (set in .env.local instead)

# Profile calls to the real backend while the rest stays mock. See .env.example. Empty = the mock answers profile calls too.
# VITE_PROFILE_API_URL= (set in .env.local instead)
