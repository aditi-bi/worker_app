# Live build. Profile and voice go through this app's own server (server/start.ts), which holds the backend token and the Sarvam key.
# Jobs and rates come from the job list (server/start.ts forwards /jobs-api). Hisaab still uses built-in sample data.
VITE_USE_MOCKS=true
VITE_API_BASE_URL=/api/v1
VITE_PROFILE_API_URL=/profile-api
VITE_JOBS_API_URL=/jobs-api
VITE_VOICE_API_URL=/voice
# Leave empty: the token must not be in the browser (the server adds it).
VITE_PROFILE_API_TOKEN=

